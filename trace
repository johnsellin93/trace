        } else if (lines[i] ~ /^[ \t]*$/) {
          continue
        } else {
          break
        }
      }

      brace_seen = 0
      depth = 0
      end = NR

      for (i = start; i <= NR; i++) {
        line = lines[i]

        for (j = 1; j <= length(line); j++) {
          ch = substr(line, j, 1)

          if (ch == "{") {
            depth++
            brace_seen = 1
          } else if (ch == "}") {
            depth--
          }
        }

        if (brace_seen && depth <= 0) {
          end = i
          break
        }
      }

      print start " " end
    }
  ' "$file"
}




trace_resolve_ansible_task_range() {
  local file="$1"
  local symbol="$2"

  awk -v sym="$symbol" '
    {
      lines[NR] = $0
    }

    END {
      start = 0

      for (i = 1; i <= NR; i++) {
        line = lines[i]

        if (line ~ /^[ \t]*-[ \t]+name:[ \t]*/) {
          name = line
          sub(/^[ \t]*-[ \t]+name:[ \t]*/, "", name)
          gsub(/^["'\''"]|["'\''"]$/, "", name)

          if (index(tolower(name), tolower(sym)) > 0) {
            if (start != 0) {
              print "MULTIPLE"
              exit
            }
            start = i
          }
        }
      }

      if (start == 0) {
        print "NONE"
        exit
      }

      end = NR

      for (i = start + 1; i <= NR; i++) {
        if (lines[i] ~ /^[ \t]*-[ \t]+name:[ \t]*/) {
          end = i - 1
          break
        }
      }

      while (end > start && lines[end] ~ /^[ \t]*$/) {
        end--
      }

      print start " " end
    }
  ' "$file"
}


trace_resolve_shell_function_range() {
  local file="$1"
  local symbol="$2"

  awk -v sym="$symbol" '
    function trim(s) {
      sub(/^[ \t]*/, "", s)
      sub(/[ \t]*$/, "", s)
      return s
    }

    function blank(s) {
      return s ~ /^[ \t]*$/
    }

    function is_target_def(line) {
      t = trim(line)

      if (t ~ "^" sym "[ \t]*\\(\\)[ \t]*(\\{|$)") return 1
      if (t ~ "^function[ \t]+" sym "([ \t]*\\(\\))?[ \t]*(\\{|$)") return 1

      return 0
    }

    function is_any_shell_def(line) {
      t = trim(line)

      if (t ~ "^[A-Za-z_][A-Za-z0-9_]*[ \t]*\\(\\)[ \t]*(\\{|$)") return 1
      if (t ~ "^function[ \t]+[A-Za-z_][A-Za-z0-9_]*([ \t]*\\(\\))?[ \t]*(\\{|$)") return 1

      return 0
    }

    {
      lines[NR] = $0
    }

    END {
      start = 0

      for (i = 1; i <= NR; i++) {
        if (is_target_def(lines[i])) {
          if (start != 0) {
            print "MULTIPLE"
            exit
          }

          start = i
        }
      }

      if (start == 0) {
        print "NONE"
        exit
      }

      end = NR

      for (i = start + 1; i <= NR; i++) {
        if (lines[i] ~ /^}[ \t]*(#.*)?$/) {
          end = i
          break
        }

        if (is_any_shell_def(lines[i])) {
          end = i - 1
          break
        }
      }

      while (end > start && blank(lines[end])) {
        end--
      }

      print start " " end
    }
  ' "$file"
}


trace_extract_html_attr_block() {
  local mode="$1"
  local target_file="$2"
  local query="$3"
  local buffer_file="$4"
  local meta_file="$5"

  awk -v mode="$mode" -v query="$query" -v meta_file="$meta_file" '
    function is_void_tag(tag) {
      return tag ~ /^(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)$/
    }

    function tag_name(line, value) {
      if (match(line, /<[[:alpha:]][[:alnum:]_:-]*/)) {
        value = substr(line, RSTART + 1, RLENGTH - 1)
        return tolower(value)
      }

      return ""
    }

    function target_line(line) {
      if (mode == "html-id") {
        return line ~ /id[ \t]*=/ && index(line, query) > 0
      }

      if (mode == "html-class") {
        return line ~ /class[ \t]*=/ && line ~ ("(^|[^A-Za-z0-9_-])" query "([^A-Za-z0-9_-]|$)")
      }

      return 0
    }

    function count_regex(line, pattern, tmp) {
      tmp = line
      return gsub(pattern, "", tmp)
    }

    {
      lines[NR] = $0
    }

    END {
      hit = 0

      for (i = 1; i <= NR; i++) {
        if (target_line(lines[i])) {
          hit = i
          break
        }
      }

      if (hit == 0) {
        print "[trace] " mode " not found: " query > "/dev/stderr"
        exit 1
      }

      start = hit

      while (start > 1 && lines[start] !~ /<[[:alpha:]][[:alnum:]_:-]*/) {
        start--
      }

      tag = tag_name(lines[start])

      if (tag == "") {
        end = hit
      } else if (is_void_tag(tag) || lines[hit] ~ /\/>/) {
        end = hit
      } else {
        depth = 0
        end = hit
        open_pattern = "<" tag "([ \t>/]|$)"
        close_pattern = "</" tag ">"

        for (i = start; i <= NR; i++) {
          opens = count_regex(lines[i], open_pattern)
          closes = count_regex(lines[i], close_pattern)
          depth += opens - closes

          if (i >= hit && closes > 0 && depth <= 0) {
            end = i
            break
          }

          if (i >= hit) {
            end = i
          }
        }
      }

      pad_start = start > 1 ? start - 1 : start
      pad_end = end < NR ? end + 1 : end

      print "lines: " pad_start "-" pad_end > meta_file
      print "label: " mode ":" query >> meta_file

      for (i = pad_start; i <= pad_end; i++) {
        print lines[i]
      }
    }
  ' "$target_file" > "$buffer_file"
}
trace_extract_html_tag_boundaries() {
  local target_file="$1"
  local query="$2"
  local buffer_file="$3"
  local meta_file="$4"

  if [[ ! "$query" =~ '^[A-Za-z][A-Za-z0-9:_-]*$' ]]; then
    print -r -- "[trace] invalid HTML tag: $query" >&2
    return 1
  fi
  awk \
    -v query="$query" \
    -v meta_file="$meta_file" '
    function count_regex(line, pattern, tmp) {
      tmp = line
      return gsub(pattern, "", tmp)
    }

    function is_void_tag(tag) {
      return tag ~ /^(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)$/
    }

    BEGIN {
      tag = tolower(query)
      open_pattern = "<" tag "([ \t>/]|$)"
      close_pattern = "</" tag "[ \t]*>"
      total_matches = 0
    }
    {
      lines[NR] = $0
      normalized = tolower($0)
      opens = count_regex(normalized, open_pattern)

      if (opens <= 0) {
        next
      }
      total_matches += opens

      for (occurrence = 1; occurrence <= opens; occurrence++) {
        opening_lines[total_matches - opens + occurrence] = NR
      }
    }

    END {
      if (total_matches == 0) {
        print "[trace] html-tag not found: " tag > "/dev/stderr"
        exit 1
      }

      print "matches: " total_matches > meta_file
      print "label: html-tag:" tag >> meta_file


      if (total_matches != 1) {
        for (match_index = 1; match_index <= total_matches; match_index++) {
          line_number = opening_lines[match_index]

          print "match " match_index ":"
          print "opening_line: " line_number
          print lines[line_number]
        }

        exit 0
      }

      start = opening_lines[1]
      end = start
      normalized_start = tolower(lines[start])

      if (is_void_tag(tag) || normalized_start ~ /\/[ \t]*>/) {
        end = start
      } else {
        depth = 0
        boundary_found = 0

        for (line_index = start; line_index <= NR; line_index++) {
          normalized = tolower(lines[line_index])
          opens = count_regex(normalized, open_pattern)
          closes = count_regex(normalized, close_pattern)
          depth += opens - closes

          if (closes > 0 && depth <= 0) {
            end = line_index
            boundary_found = 1
            break
          }
        }

        if (!boundary_found) {
          print "[trace] html-tag has no complete closing boundary: " tag > "/dev/stderr"
          exit 1
        }
      }

      print "match 1:"
      print "opening_line: " start
      print lines[start]
      print "closing_line: " end

      if (end != start) {
        print lines[end]
      }
    }
  ' "$target_file" > "$buffer_file"
}

trace_extract_css_block() {
  local target_file="$1"
  local selector="$2"
  local buffer_file="$3"
  local meta_file="$4"

  awk -v selector="$selector" -v meta_file="$meta_file" '
    function trim(value) {
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      return value
    }

    function count_open(line, tmp) {
      tmp = line
      return gsub(/\{/, "", tmp)
    }

    function count_close(line, tmp) {
      tmp = line
      return gsub(/\}/, "", tmp)
    }

    {
      lines[NR] = $0
    }

    END {
      for (i = 1; i <= NR; i++) {
        line = trim(lines[i])

        if (index(line, selector) == 0) {
          continue
        }

        if (line ~ /^</ || line ~ /=/) {
          continue
        }

        brace_line = 0

        for (j = i; j <= NR; j++) {
          candidate = trim(lines[j])

          if (candidate ~ /^</) {
            break
          }

          if (index(candidate, "{") > 0) {
            brace_line = j
            break
          }

          if (index(candidate, "}") > 0 || index(candidate, ";") > 0) {
            break
          }
        }

        if (brace_line == 0) {
          continue
        }

        start = i

        while (start > 1) {
          previous = trim(lines[start - 1])

          if (previous == "" || previous ~ /^</ || previous ~ /[{};]/) {
            break
          }

          if (previous ~ /,$/) {
            start--
            continue
          }

          break
        }

        depth = 0
        end = brace_line

        for (j = start; j <= NR; j++) {
          depth += count_open(lines[j]) - count_close(lines[j])

          if (j >= brace_line && depth <= 0) {
            end = j
            break
          }
        }

        print "lines: " start "-" end > meta_file
        print "label: css:" selector >> meta_file

        for (j = start; j <= end; j++) {
          print lines[j]
        }

        exit 0
      }

      print "[trace] CSS selector not found: " selector > "/dev/stderr"
      exit 1
    }
  ' "$target_file" > "$buffer_file"
}

trace_extract_json_path() {
  local target_file="$1"
  local json_path="$2"
  local buffer_file="$3"
  local meta_file="$4"

  if ! command -v jq >/dev/null 2>&1; then
