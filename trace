          > "$candidate_diff" || true

        candidate_bytes=$(
          wc -c < "$candidate_diff" |
            tr -d ' '
        )


        cat "$candidate_diff" >> "$diff_file"

        diff_files_returned=$((diff_files_returned + 1))
        diff_bytes_returned=$((diff_bytes_returned + candidate_bytes))
      done < "$added_file"

      while IFS= read -r relative_path; do
        [[ -n "$relative_path" ]] || continue


        if (( diff_files_returned >= max_diff_files )); then
          break
        fi

        : > "$candidate_diff"

        git diff \
          --no-index \
          --no-color \
          -- \
          "${before_root}/${relative_path}" \
          /dev/null \
          > "$candidate_diff" || true

        candidate_bytes=$(
          wc -c < "$candidate_diff" |
            tr -d ' '
        )


        cat "$candidate_diff" >> "$diff_file"

        diff_files_returned=$((diff_files_returned + 1))
        diff_bytes_returned=$((diff_bytes_returned + candidate_bytes))
      done < "$deleted_file"

    else
      while IFS= read -r relative_path; do
        [[ -n "$relative_path" ]] || continue


        if (( diff_files_returned >= max_diff_files )); then
          break
        fi

        : > "$candidate_diff"

        diff -u \
          -- \
          "${before_root}/${relative_path}" \
          "${after_root}/${relative_path}" \
          > "$candidate_diff" || true

        candidate_bytes=$(
          wc -c < "$candidate_diff" |
            tr -d ' '
        )


        cat "$candidate_diff" >> "$diff_file"

        diff_files_returned=$((diff_files_returned + 1))
        diff_bytes_returned=$((diff_bytes_returned + candidate_bytes))
      done < "$modified_file"

      while IFS= read -r relative_path; do
        [[ -n "$relative_path" ]] || continue

        if (( diff_files_returned >= max_diff_files )); then
          break
        fi

        : > "$candidate_diff"

        diff -u \
          -- \
          /dev/null \
          "${after_root}/${relative_path}" \
          > "$candidate_diff" || true

        candidate_bytes=$(
          wc -c < "$candidate_diff" |
            tr -d ' '
        )


        cat "$candidate_diff" >> "$diff_file"

        diff_files_returned=$((diff_files_returned + 1))
        diff_bytes_returned=$((diff_bytes_returned + candidate_bytes))
      done < "$added_file"

      while IFS= read -r relative_path; do
        [[ -n "$relative_path" ]] || continue


        if (( diff_files_returned >= max_diff_files )); then
          break
        fi

        : > "$candidate_diff"

        diff -u \
          -- \
          "${before_root}/${relative_path}" \
          /dev/null \
          > "$candidate_diff" || true

        candidate_bytes=$(
          wc -c < "$candidate_diff" |
            tr -d ' '
        )

        cat "$candidate_diff" >> "$diff_file"

        diff_files_returned=$((diff_files_returned + 1))
        diff_bytes_returned=$((diff_bytes_returned + candidate_bytes))
      done < "$deleted_file"
    fi
  fi
  {
    print -r -- "comparison-direction: BEFORE -> AFTER"
    print -r -- "comparison-kind: repository"
    print -r -- "before: $before_root"
    print -r -- "after: $after_root"
    print -r -- "differences: $differences"
    print -r -- "changed-files: $changed_count"
    print -r -- "modified-files: $modified_count"
    print -r -- "added-files: $added_count"
    print -r -- "deleted-files: $deleted_count"
    print -r -- "diff-files-returned: $diff_files_returned"
    print -r -- "diff-bytes-returned: $diff_bytes_returned"

    if (( modified_count > 0 )); then
      print -r -- ""
      print -r -- "MODIFIED"

      while IFS= read -r relative_path; do
        print -r -- "  $relative_path"
