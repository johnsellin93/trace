trace_extract_jq_query() {
  local target_file="$1"
  local jq_query="$2"
  local buffer_file="$3"
  local meta_file="$4"

  local jq_cmd=""
  jq_cmd="$(whence -p jq 2>/dev/null || true)"

  if [[ -z "$jq_cmd" ]]; then
    print -r -- "[trace] -jq requires jq" >&2
    return 1
  fi

  local timeout_cmd=""
  timeout_cmd="$(whence -p timeout 2>/dev/null || true)"

  if [[ -z "$timeout_cmd" ]]; then
    timeout_cmd="$(whence -p gtimeout 2>/dev/null || true)"
  fi

  if [[ -z "$timeout_cmd" ]]; then
    print -r -- \
      "[trace] -jq requires timeout (GNU coreutils; gtimeout on macOS)" >&2
    return 1
  fi

  if [[ -z "$jq_query" ]]; then
    print -r -- "[trace] -jq requires a non-empty jq filter" >&2
    return 1
  fi

  local timeout_seconds="${TRACE_JQ_TIMEOUT_SECONDS:-10}"

  if [[ ! "$timeout_seconds" =~ '^[1-9][0-9]*$' ]]; then
    print -r -- \
      "[trace] invalid TRACE_JQ_TIMEOUT_SECONDS: $timeout_seconds" >&2
    return 1
  fi

  local temp_prefix="${buffer_file}.jq.$$"
  local raw_file="${temp_prefix}.raw.tmp"
  local error_file="${temp_prefix}.stderr.tmp"
  local module_dir="${temp_prefix}.modules"

  mkdir -p "$module_dir"
  : > "$raw_file"
  : > "$error_file"

  # Process every input value from JSON or JSONL.
  # There is intentionally NO item limit and NO byte limit.
  local jq_program="inputs | (${jq_query})"
  local jq_status=0

  # Clear inherited environment so jq env/$ENV cannot expose secrets.
  # Empty -L directory also prevents importing arbitrary jq modules.
  env -i \
    LC_ALL=C \
    "$timeout_cmd" --signal=TERM --kill-after=2s "${timeout_seconds}s" \
    "$jq_cmd" \
      --null-input \
      --compact-output \
      --monochrome-output \
      -L "$module_dir" \
      "$jq_program" \
      "$target_file" \
      > "$raw_file" \
      2> "$error_file" || jq_status=$?

  if (( jq_status != 0 )); then
    if (( jq_status == 124 || jq_status == 137 )); then
      print -r -- \
        "[trace] jq query timed out after ${timeout_seconds}s" >&2
    else
      print -r -- \
        "[trace] jq query failed with status $jq_status" >&2

      if [[ -s "$error_file" ]]; then
        cat "$error_file" >&2
        print -r -- "" >&2
      fi
    fi

    rm -f -- \
      "$raw_file" \
      "$error_file"

    rmdir -- "$module_dir" 2>/dev/null || true

    return 1
  fi

  mv -- "$raw_file" "$buffer_file"

  local returned_items
  local returned_bytes

  returned_items=$(wc -l < "$buffer_file" | tr -d ' ')
  returned_bytes=$(wc -c < "$buffer_file" | tr -d ' ')

  {
    print -r -- "label: jq"
    print -r -- "format: compact-jsonl"
    print -r -- "returned-items: $returned_items"
    print -r -- "returned-bytes: $returned_bytes"
    print -r -- "timeout: ${timeout_seconds}s"
  } > "$meta_file"
  rm -f -- "$error_file"
  rmdir -- "$module_dir" 2>/dev/null || true
}

