#!/usr/bin/env zsh
set -euo pipefail
# AI context trace for terminal workflows, search/extract → accumulate context → copy to clipboard.

usage() {
  cat <<'EOF'
Usage:
  trace <pattern> [path...]
#   trace --all <pattern> [path...]
  trace --context <N> <pattern> [path...]
  trace --symbol <file> <symbol>
  trace <start> <end> <file> [label...]
  trace --replace <start> <end> <file> <expected-label>
  trace --snapshot <file-or-dir>
  trace --diff <before> <after>
  trace --diff-symbol <before-file> <after-file> <symbol>
  trace -jq <file> <filter>
  trace --clear
  trace --functions <file> [symbol]
  trace --help
  trace -h

Examples:

  trace variable /dir/proj
  trace --all VAR
  trace --diff old/trace_state.py new/trace_state.py
  trace --diff /path/to/before-repo /path/to/after-repo
  trace --diff-symbol \
  /root/rgui/trace_old/trace_state.py \
  /root/rgui/trace_new/trace_state.py \
  build_state
  trace --diff-symbol \
    /root/rgui/trace_old/trace_state.py \
    /root/rgui/trace_new/state/trace_state.py \
    build_state
  trace --diff-symbol \
    /root/rgui/tracez_v_287_before_suffciency_prompt/trace \
    /root/rgui/trace \
    trace_run_repo_diff
  trace --diff-symbol old/trace_state.py new/trace_state.py build_state
  trace -jq events.jsonl 'select(.round == 14) | {round,type,message}'
  trace --context 25 Cancel trace-ui.html
  trace --context 40 progress-label trace-ui.html
  trace --symbol trace-ui.html renderRun
  trace --symbol trace-agent1.py run_trace
  trace 500 635 file.cs HandleSetupHotkeys
  trace --replace 122 166 server.py _log_request_start
  sed -n '500,635p' file.cs | trace HandleSetupHotkeys
  trace --clear
  trace --functions ./app.py
  trace --functions ./UserService.cs SaveUser
  trace --html-id <file> <id>
  trace --html-class <file> <class>
  trace --html-tag <file> <tag>
  trace --css <file> <selector>
  trace --json-path <file> <path>
  trace --yaml-path <file> <path>
  trace --heading <file> <heading>
# --html-id adds one context line before/after. That is okay.
# --html-class returns first match only. That is okay for v1.
# #CSS block extraction from inline CSS in trace-ui.html works.
# HTML id extraction works.
# HTML class extraction works.
# JS symbol extraction still works.
# JSON path extraction works.

Comparison:
   trace --diff <before> <after>
       Compare files or repositories.
       Direction is always BEFORE -> AFTER.
       Repository mode returns a changed-file manifest plus complete
       unified diff hunks for every changed file.
  trace --diff-symbol <before-file> <after-file> <symbol>
      Resolve the symbol independently in BEFORE and AFTER and diff
      only the resolved symbol slices.
      Symbols may move to different line numbers between versions.
      Supported:
        Python
        JS / JSX / TS / TSX / HTML
        sh / bash / zsh / trace
      Missing or ambiguous symbols fail closed.
Structured JSON / JSONL:
  trace -jq <file> <filter>
      Run a jq filter over JSON or JSONL.
      Returns every complete compact JSON result.
      Timeout guard:
        TRACE_JQ_TIMEOUT_SECONDS=10
Modes:
  trace --context  Extract around matches with rg -C and append to context
  trace --symbol   Extract a whole function/task by symbol without editing
  trace --snapshot .
  trace --snapshot ./src
  trace --snapshot /full/path/to/file.py
  default     Search smart project files only
  --all       Search all non-ignored files from type_filters
  range       Extract line range from file
  --replace   Replace exact line range after pasted reviewed code
  stdin       Capture piped input automatically
Notes:
  - Latest clean output: ~/.cache/trace/buffer.txt
  - AI context history:   ~/.cache/trace/context.txt
  - Copies to tmux/clipboard when available
EOF
}


trace_print_footer() {
  local copy_target="$1"
  local context_file="$2"
  local added_lines="${3:-0}"
  local label="${4:-}"

  local context_lines
  local context_bytes
  local footer

  context_lines=$(wc -l < "$context_file" | tr -d ' ')
  context_bytes=$(wc -c < "$context_file" | tr -d ' ')

  footer="${added_lines}|${context_lines}|${context_bytes}|${copy_target}|${label}"

  trace_emit_footer "$footer"
}

trace_emit_footer() {
  local footer="$1"

  if [[ "${TRACE_DELAY_FOOTER:-0}" != "1" ]]; then
    local added_lines context_lines context_bytes copy_target label

    IFS='|' read -r added_lines context_lines context_bytes copy_target label <<< "$footer"

    print -r -- ""
    if [[ -n "$label" ]]; then
      print -r -- "[trace] ${label} +${added_lines}L → context ${context_lines}L / ${context_bytes}B copied to ${copy_target}"
    else
      print -r -- "[trace] +${added_lines}L → context ${context_lines}L / ${context_bytes}B copied to ${copy_target}"
    fi
    return
  fi

  local buffer_dir="${TRACE_BUFFER_DIR:-$HOME/.cache/trace}"
  local footer_queue="${buffer_dir}/footer_queue.txt"
  local footer_lock="${buffer_dir}/footer_queue.lock"

  mkdir -p "$buffer_dir"
  print -r -- "$footer" >> "$footer_queue"

  (
    exec 9>"$footer_lock"

    if ! flock -n 9; then
      exit 0
    fi

    sleep 1.0

    if [[ -s "$footer_queue" ]]; then
      local count total_added last_context_lines last_context_bytes last_copy_target
      count=$(wc -l < "$footer_queue" | tr -d ' ')
      total_added=0

      while IFS='|' read -r added_lines context_lines context_bytes copy_target label; do
        total_added=$((total_added + added_lines))
        last_context_lines="$context_lines"
        last_context_bytes="$context_bytes"
        last_copy_target="$copy_target"
      done < "$footer_queue"

      print -r -- ""
      print -r -- "[trace] appended ${count} blocks / +${total_added}L → context ${last_context_lines}L / ${last_context_bytes}B copied to ${last_copy_target}"

      while IFS='|' read -r added_lines context_lines context_bytes copy_target label; do
        if [[ -n "$label" ]]; then
          print -r -- "  +${added_lines}L  ${label}"
        else
          print -r -- "  +${added_lines}L"
        fi
      done < "$footer_queue"

      : > "$footer_queue"
    fi
  ) &
}

trace_detect_symbol_name() {
  local file="$1"
  local start_line="$2"

  awk -v start="$start_line" '
    NR > start { exit }

    /^[[:space:]]*def[[:space:]]+/ ||
    /^[[:space:]]*async[[:space:]]+def[[:space:]]+/ ||
    /^[[:space:]]*function[[:space:]]+/ ||
    /^[[:space:]]*(public|private|protected|internal|static|async)/ {

      line=$0
      sub(/^[[:space:]]*/, "", line)

      sig=line
    }

    END {
      print sig
    }
  ' "$file"
}

trace_validate_file_syntax() {
  local file="$1"

  case "$file" in
    *.py)
      if command -v python3 >/dev/null 2>&1; then
        python3 -m py_compile "$file"
      elif command -v python >/dev/null 2>&1; then
        python -m py_compile "$file"
      else
        print -r -- "[trace] syntax validation skipped: python not found"
      fi
      ;;

    *.sh|*.bash)
      if command -v bash >/dev/null 2>&1; then
        bash -n "$file"
      else
        print -r -- "[trace] syntax validation skipped: bash not found"
      fi
      ;;

    *.zsh)
      if command -v zsh >/dev/null 2>&1; then
        zsh -n "$file"
      else
        print -r -- "[trace] syntax validation skipped: zsh not found"
      fi
      ;;

    *.yml|*.yaml)
      if command -v python3 >/dev/null 2>&1; then
        python3 - <<PY
import sys, yaml
with open("$file", "r", encoding="utf-8") as f:
    yaml.safe_load(f)
PY
      else
        print -r -- "[trace] syntax validation skipped: python3 not found"
      fi
      ;;

    *)
      print -r -- "[trace] syntax validation skipped for file type: $file"
      ;;
  esac
}

trace_resolve_python_function_range() {
  local file="$1"
  local symbol="$2"

  awk -v sym="$symbol" '
    function lead(s, t) {
      t = s
      sub(/[^ \t].*$/, "", t)
      return length(t)
    }

    function blank(s) {
      return s ~ /^[ \t]*$/
    }

    function comment(s) {
      return s ~ /^[ \t]*#/
    }

    function header_complete(s) {
      return s ~ /:[ \t]*(#.*)?$/
    }

    {
      lines[NR] = $0
    }

    END {
      def_line = 0
      pattern = "^[ \t]*(async[ \t]+)?def[ \t]+" sym "[ \t]*\\("

      for (i = 1; i <= NR; i++) {
        if (lines[i] ~ pattern) {
          if (def_line != 0) {
            print "MULTIPLE"
            exit
          }

          def_line = i
        }
      }

      if (def_line == 0) {
        print "NONE"
        exit
      }

      start = def_line

      for (i = def_line - 1; i >= 1; i--) {
        if (lines[i] ~ /^[ \t]*@/) {
          start = i
        } else {
          break
        }
      }

      base_indent = lead(lines[def_line])
      end = NR
      in_header = !header_complete(lines[def_line])
      body_seen = 0

      for (i = def_line + 1; i <= NR; i++) {
        if (in_header) {
          if (header_complete(lines[i])) {
            in_header = 0
          }
          continue
        }

        if (blank(lines[i]) || comment(lines[i])) {
          continue
        }

        if (lead(lines[i]) <= base_indent) {
          if (body_seen) {
            end = i - 1
            break
          }

          continue
        }

        body_seen = 1
      }

      while (end > def_line && blank(lines[end])) {
        end--
      }

      print start " " end
    }
  ' "$file"
}

trace_resolve_js_ts_function_range() {
  local file="$1"
  local symbol="$2"

  awk -v sym="$symbol" '
    function trim(s) {
      sub(/^[ \t]*/, "", s)
      sub(/[ \t]*$/, "", s)
      return s
    }

    function is_match(line) {
      t = trim(line)

      if (t ~ "^(async[ \t]+)?function[ \t]+" sym "[ \t]*\\(") return 1
      if (t ~ "^(export[ \t]+)?(async[ \t]+)?function[ \t]+" sym "[ \t]*\\(") return 1
      if (t ~ "^(export[ \t]+)?(const|let|var)[ \t]+" sym "[ \t]*=[ \t]*(async[ \t]*)?\\(") return 1
      if (t ~ "^(export[ \t]+)?(const|let|var)[ \t]+" sym "[ \t]*=[ \t]*(async[ \t]*)?[A-Za-z0-9_$]+[ \t]*=>") return 1
      if (t ~ "^(export[ \t]+)?(const|let|var)[ \t]+" sym "[ \t]*=[ \t]*(async[ \t]*)?function[ \t]*\\(") return 1

      return 0
    }

    {
      lines[NR] = $0
    }

    END {
      start = 0

      for (i = 1; i <= NR; i++) {
        if (is_match(lines[i])) {
          if (start != 0) {
            print "MULTIPLE"
            exit
          }
          start = i
        }
      }

      if (start == 0) {
        print "NONE"
        exit
      }

      brace_seen = 0
      depth = 0
      end = NR

      for (i = start; i <= NR; i++) {
        line = lines[i]

        for (j = 1; j <= length(line); j++) {
          ch = substr(line, j, 1)

          if (ch == "{") {
            depth++
            brace_seen = 1
          } else if (ch == "}") {
            depth--
          }
        }

        if (brace_seen && depth <= 0) {
          end = i
          break
        }
      }

      print start " " end
    }
  ' "$file"
}

