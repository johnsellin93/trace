    case "$target_file" in
      *.py)
        resolved="$(trace_resolve_python_function_range "$target_file" "$expected_label")"
        ;;
      *.js|*.jsx|*.ts|*.tsx)
        resolved="$(trace_resolve_js_ts_function_range "$target_file" "$expected_label")"
        ;;
      *.cs|*.java)
        resolved="$(trace_resolve_csharp_function_range "$target_file" "$expected_label")"
        ;;
      *.yml|*.yaml)
        resolved="$(trace_resolve_ansible_task_range "$target_file" "$expected_label")"
        ;;
      *)
        print -r -- "[trace] --replace FILE SYMBOL does not support this file type yet: $target_file" >&2
        print -r -- "[trace] use range mode:" >&2
        print -r -- "  trace --replace <start> <end> <file> <expected-label>" >&2
        exit 1
        ;;
    esac

    case "$resolved" in
      NONE)
        print -r -- "[trace] symbol not found: $expected_label" >&2
        exit 1
        ;;
      MULTIPLE)
        print -r -- "[trace] multiple matches found: $expected_label" >&2
        print -r -- "[trace] use range mode or a more specific file/symbol" >&2
        exit 1
        ;;
    esac

    start_line="${resolved%% *}"
    end_line="${resolved##* }"

    trace_apply_replace_range "$start_line" "$end_line" "$target_file" "$expected_label"
    exit 0
  fi

  print -r -- "[trace] usage:" >&2
