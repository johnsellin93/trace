trace_apply_replace_range() {
  local start_line="$1"
  local end_line="$2"
  local target_file="$3"
  local expected_label="$4"

  if [[ ! "$start_line" =~ '^[0-9]+$' ]] || [[ ! "$end_line" =~ '^[0-9]+$' ]]; then
    print -r -- "[trace] replace requires numeric start/end lines" >&2
    exit 1
  fi

  if [[ ! -f "$target_file" ]]; then
    print -r -- "[trace] replace target file not found: $target_file" >&2
    exit 1
  fi

  if (( start_line <= 0 || end_line < start_line )); then
    print -r -- "[trace] invalid range: ${start_line}-${end_line}" >&2
    exit 1
  fi


  old_block="$(sed -n "${start_line},${end_line}p" "$target_file")"

  if ! print -r -- "$old_block" | grep -Fq -- "$expected_label"; then
    print -r -- "[trace] expected label not found in resolved range" >&2
    print -r -- "  file   : $target_file" >&2
    print -r -- "  lines  : ${start_line}-${end_line}" >&2
    print -r -- "  expect : $expected_label" >&2
    exit 1
  fi

  tmp_dir="${TRACE_BUFFER_DIR:-$HOME/.cache/trace}"
  mkdir -p "$tmp_dir"

  replacement_file="${tmp_dir}/replacement.tmp"
  ext="${target_file:e}"
  if [[ -n "$ext" ]]; then
    new_file="${tmp_dir}/replace.$$.${ext}"
  else
    new_file="${tmp_dir}/replace.$$"
  fi

  backup_file="${target_file}.trace.bak.$(date +%Y%m%d%H%M%S)"

  print -r -- "[trace] replacing:"
  print -r -- "  file   : $target_file"
  print -r -- "  lines  : ${start_line}-${end_line}"
  print -r -- "  expect : $expected_label"
  print -r -- ""
  print -r -- "Paste replacement now. Press Ctrl-D when finished."
  print -r -- "------------------------------------------------------------"

  cat > "$replacement_file"

  if [[ ! -s "$replacement_file" ]]; then
    print -r -- "[trace] replacement was empty; aborting" >&2
    exit 1
  fi

  if ! grep -Fq -- "$expected_label" "$replacement_file"; then
    print -r -- "[trace] expected label not found in pasted replacement" >&2
    print -r -- "  expect: $expected_label" >&2
    exit 1
  fi

  cp "$target_file" "$backup_file"

  awk -v start="$start_line" -v end="$end_line" -v repl="$replacement_file" '
    NR == start {
      while ((getline line < repl) > 0) {
        print line
      }
    }

    NR < start || NR > end {
      print
    }
  ' "$target_file" > "$new_file"

  set +e
  validation_output="$(trace_validate_file_syntax "$new_file" 2>&1)"
  validation_status=$?
  set -e

  if (( validation_status != 0 )); then
    print -r -- "[trace] syntax validation failed; target file unchanged" >&2
    print -r -- ""
    print -r -- "$validation_output" >&2
    print -r -- ""
    print -r -- "backup: $backup_file" >&2
    rm -f "$replacement_file" "$new_file"
    exit 1
  fi

  if cmp -s "$backup_file" "$new_file"; then
    print -r -- "[trace] replacement is identical; target file unchanged"
    rm -f "$replacement_file" "$new_file" "$backup_file"
    exit 0
  fi

  print -r -- ""
  print -r -- "[trace] diff:"
  print -r -- "------------------------------------------------------------"

  if command -v git >/dev/null 2>&1; then
    git diff --no-index --color=always "$backup_file" "$new_file" || true
  else
    diff -u "$backup_file" "$new_file" || true
  fi

  print -r -- "------------------------------------------------------------"
  print -r -- ""

  print -n -- "Apply replacement? [y/N] "
  read -r answer

  case "$answer" in
    y|Y|yes|YES)
      cp "$new_file" "$target_file"
      print -r -- "[trace] replacement applied"
      print -r -- "  backup: $backup_file"
      ;;
    *)
      print -r -- "[trace] replacement cancelled; target file unchanged"
      print -r -- "  backup: $backup_file"
      ;;
  esac

  rm -f "$replacement_file" "$new_file"
}



