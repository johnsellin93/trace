trace_extract_markdown_heading() {
  local target_file="$1"
  local heading="$2"
  local buffer_file="$3"
  local meta_file="$4"

  awk -v heading="$heading" -v meta_file="$meta_file" '
    function normalize(value) {
      gsub(/^#+[ \t]*/, "", value)
      gsub(/[ \t]*#+[ \t]*$/, "", value)
      gsub(/[ \t]+/, " ", value)
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      return tolower(value)
    }

    {
      lines[NR] = $0
    }

    END {
      wanted = normalize(heading)
      start = 0
      level = 0

      for (i = 1; i <= NR; i++) {
        if (lines[i] !~ /^#{1,6}[ \t]+/) {
          continue
        }

        match(lines[i], /^#+/)
        this_level = RLENGTH
        title = normalize(lines[i])

        if (title == wanted || index(title, wanted) > 0) {
          start = i
          level = this_level
          break
        }
      }

      if (start == 0) {
        print "[trace] heading not found: " heading > "/dev/stderr"
        exit 1
      }

      end = NR

      for (i = start + 1; i <= NR; i++) {
        if (lines[i] ~ /^#{1,6}[ \t]+/) {
          match(lines[i], /^#+/)
          this_level = RLENGTH

          if (this_level <= level) {
            end = i - 1
            break
          }
        }
      }

      while (end > start && lines[end] ~ /^[ \t]*$/) {
        end--
      }

      print "lines: " start "-" end > meta_file
      print "label: heading:" heading >> meta_file

      for (i = start; i <= end; i++) {
        print lines[i]
      }
    }
  ' "$target_file" > "$buffer_file"
}
trace_run_structured_extract() {
  local mode="$1"
  local source_label="$2"
  local target_file="$3"
  local query="$4"

  if [[ ! -f "$target_file" ]]; then
    print -r -- \
      "[trace] target file not found: $target_file" >&2
    return 1
  fi

  local buffer_dir="${TRACE_BUFFER_DIR:-$HOME/.cache/trace}"
  local buffer_file="${TRACE_BUFFER_FILE:-$buffer_dir/buffer.txt}"
  local context_file="${TRACE_CONTEXT_FILE:-$buffer_dir/context.txt}"
  local counter_file="${TRACE_COUNTER_FILE:-$buffer_dir/counter.txt}"
  local meta_file="${buffer_file}.meta.tmp"
  local result_file="${buffer_file}.structured.$$"

  mkdir -p "$buffer_dir"

  : > "$meta_file"
  : > "$result_file"

  if [[ ! -f "$context_file" ]]; then
    : > "$context_file"
  fi

  if [[ ! -f "$counter_file" ]]; then
    print -r -- "0" > "$counter_file"
  fi

  local extract_status=0

  case "$mode" in
    html-id|html-class)
      trace_extract_html_attr_block \
        "$mode" \
        "$target_file" \
        "$query" \
        "$result_file" \
        "$meta_file" || extract_status=$?
      ;;

    html-tag)
      trace_extract_html_tag_boundaries \
        "$target_file" \
        "$query" \
        "$result_file" \
        "$meta_file" || extract_status=$?
      ;;

    css)
      trace_extract_css_block \
        "$target_file" \
        "$query" \
        "$result_file" \
        "$meta_file" || extract_status=$?
      ;;

    json-path)
      trace_extract_json_path \
        "$target_file" \
        "$query" \
        "$result_file" \
        "$meta_file" || extract_status=$?
      ;;

    jq)
      trace_extract_jq_query \
        "$target_file" \
        "$query" \
        "$result_file" \
        "$meta_file" || extract_status=$?
      ;;

    yaml-path)
      trace_extract_yaml_path \
        "$target_file" \
        "$query" \
        "$result_file" \
        "$meta_file" || extract_status=$?
      ;;

    heading)
      trace_extract_markdown_heading \
        "$target_file" \
        "$query" \
        "$result_file" \
        "$meta_file" || extract_status=$?
      ;;

    *)
      print -r -- \
        "[trace] unknown structured mode: $mode" >&2
      extract_status=1
      ;;
  esac

  if (( extract_status != 0 )); then
    rm -f -- \
      "$result_file" \
      "$meta_file"

    local preserved_copy_target="none"

    if [[ -n "${TMUX:-}" ]] &&
       command -v tmux >/dev/null 2>&1; then
      tmux load-buffer "$context_file"
      preserved_copy_target="tmux buffer"

    elif command -v wl-copy >/dev/null 2>&1 &&
         [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
      wl-copy < "$context_file"
      preserved_copy_target="Wayland clipboard"

    elif command -v xclip >/dev/null 2>&1 &&
         [[ -n "${DISPLAY:-}" ]]; then
      xclip -selection clipboard -in < "$context_file"
      preserved_copy_target="X clipboard via xclip"

    elif command -v pbcopy >/dev/null 2>&1; then
      pbcopy < "$context_file"
      preserved_copy_target="macOS clipboard"
    fi

    print -r -- \
      "[trace] ${source_label} failed; accumulated context preserved and copied to ${preserved_copy_target}" >&2

    return "$extract_status"
  fi

  # Only replace the latest clean buffer after extraction succeeded.
  mv -- "$result_file" "$buffer_file"

  local run_no

  run_no="$(
    cat "$counter_file" 2>/dev/null ||
      print -r -- 0
  )"

  run_no=$((run_no + 1))
  print -r -- "$run_no" > "$counter_file"

  {
    print -r -- ""
    print -r -- \
      "==================== trace copy ${run_no} ===================="
    print -r -- "source: ${source_label}"
    print -r -- "file: $target_file"
    print -r -- "query: $query"

    if [[ -s "$meta_file" ]]; then
      cat "$meta_file"
    fi

    print -r -- \
      "============================================================="

    cat "$buffer_file"
  } >> "$context_file"

  cat "$buffer_file"

  local copy_target="none"

  if [[ -n "${TMUX:-}" ]] &&
     command -v tmux >/dev/null 2>&1; then
    tmux load-buffer "$context_file"
    copy_target="tmux buffer"

  elif command -v wl-copy >/dev/null 2>&1 &&
       [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    wl-copy < "$context_file"
    copy_target="Wayland clipboard"

  elif command -v xclip >/dev/null 2>&1 &&
       [[ -n "${DISPLAY:-}" ]]; then
    xclip -selection clipboard -in < "$context_file"
    copy_target="X clipboard via xclip"

  elif command -v pbcopy >/dev/null 2>&1; then
    pbcopy < "$context_file"
    copy_target="macOS clipboard"
  fi

  local line_count
  local footer_label="${source_label}:${query}"

  line_count=$(wc -l < "$buffer_file" | tr -d ' ')

  if [[ "$mode" == "jq" ]]; then
    footer_label="jq"
  fi

  trace_print_footer \
    "$copy_target" \
    "$context_file" \
    "$line_count" \
    "$footer_label"

  rm -f "$meta_file"
}

trace_run_repo_diff() {
  local before_root="$1"
  local after_root="$2"

  if [[ ! -d "$before_root" ]]; then
    print -r -- "[trace] diff BEFORE repository not found: $before_root" >&2
    return 1
  fi

  if [[ ! -d "$after_root" ]]; then
    print -r -- "[trace] diff AFTER repository not found: $after_root" >&2
    return 1
  fi

  local buffer_dir="${TRACE_BUFFER_DIR:-$HOME/.cache/trace}"
  local buffer_file="${TRACE_BUFFER_FILE:-$buffer_dir/buffer.txt}"
  local context_file="${TRACE_CONTEXT_FILE:-$buffer_dir/context.txt}"
  local counter_file="${TRACE_COUNTER_FILE:-$buffer_dir/counter.txt}"

  local temp_prefix="${buffer_file}.repo-diff.$$"
  local paths_file="${temp_prefix}.paths"
  local modified_file="${temp_prefix}.modified"
  local added_file="${temp_prefix}.added"
  local deleted_file="${temp_prefix}.deleted"
  local diff_file="${temp_prefix}.diff"
  local candidate_diff="${temp_prefix}.candidate"
  mkdir -p "$buffer_dir"

  : > "$buffer_file"
  : > "$paths_file"
  : > "$modified_file"
  : > "$added_file"
  : > "$deleted_file"
  : > "$diff_file"
  : > "$candidate_diff"
  if [[ ! -f "$context_file" ]]; then
    : > "$context_file"
  fi

  if [[ ! -f "$counter_file" ]]; then
    print -r -- "0" > "$counter_file"
  fi

  {
    find "$before_root" \
      \( -type d \( \
           -name '.git' -o \
           -name '.ruff_cache' -o \
           -name '__pycache__' -o \
           -name '.venv' -o \
           -name 'venv' -o \
           -name 'vendor' -o \
           -name 'node_modules' -o \
           -name 'dist' -o \
           -name 'build' -o \
           -name 'coverage' -o \
           -name 'tmp' -o \
           -name 'bin' -o \
           -name 'obj' \
         \) -prune \) -o \
      -type f \
      -printf '%P\n'

    find "$after_root" \
      \( -type d \( \
           -name '.git' -o \
           -name '.ruff_cache' -o \
           -name '__pycache__' -o \
           -name '.venv' -o \
           -name 'venv' -o \
           -name 'vendor' -o \
           -name 'node_modules' -o \
           -name 'dist' -o \
           -name 'build' -o \
           -name 'coverage' -o \
           -name 'tmp' -o \
           -name 'bin' -o \
           -name 'obj' \
         \) -prune \) -o \
      -type f \
      -printf '%P\n'
  } |
    LC_ALL=C sort -u \
    > "$paths_file"
  local relative_path
  local before_file
  local after_file

  while IFS= read -r relative_path; do
    [[ -n "$relative_path" ]] || continue

    before_file="${before_root}/${relative_path}"
    after_file="${after_root}/${relative_path}"

    if [[ -f "$before_file" && -f "$after_file" ]]; then
      if ! cmp -s -- "$before_file" "$after_file"; then
        print -r -- "$relative_path" >> "$modified_file"
      fi
    elif [[ -f "$after_file" ]]; then
      print -r -- "$relative_path" >> "$added_file"
    elif [[ -f "$before_file" ]]; then
      print -r -- "$relative_path" >> "$deleted_file"
    fi
  done < "$paths_file"
  local modified_count
  local added_count
  local deleted_count
  local changed_count
  local differences
  local diff_files_returned=0
  local diff_bytes_returned=0
  local candidate_bytes=0
  modified_count=$(
    wc -l < "$modified_file" |
      tr -d ' '
  )

  added_count=$(
    wc -l < "$added_file" |
      tr -d ' '
  )

  deleted_count=$(
    wc -l < "$deleted_file" |
      tr -d ' '
  )
  changed_count=$((modified_count + added_count + deleted_count))
  if (( changed_count == 0 )); then
    differences="none"
  else
    differences="present"

    if command -v git >/dev/null 2>&1; then
      while IFS= read -r relative_path; do
        [[ -n "$relative_path" ]] || continue

        : > "$candidate_diff"

        git diff \
          --no-index \
          --no-color \
          -- \
          "${before_root}/${relative_path}" \
          "${after_root}/${relative_path}" \
          > "$candidate_diff" || true

        candidate_bytes=$(
          wc -c < "$candidate_diff" |
            tr -d ' '
        )


        cat "$candidate_diff" >> "$diff_file"

        diff_files_returned=$((diff_files_returned + 1))
        diff_bytes_returned=$((diff_bytes_returned + candidate_bytes))
      done < "$modified_file"

      while IFS= read -r relative_path; do
        [[ -n "$relative_path" ]] || continue

        if (( diff_files_returned >= max_diff_files )); then
