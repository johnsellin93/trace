      )"
      ;;

    *.sh|*.bash|*.zsh|*/trace|trace)
      before_resolved="$(
        trace_resolve_shell_function_range \
          "$before_file" \
          "$symbol"
      )"
      ;;

    *)
      print -r -- \
        "[trace] --diff-symbol does not support BEFORE file type yet: $before_file" >&2
      return 1
      ;;
  esac

  case "$after_file" in
    *.py)
      after_resolved="$(
        trace_resolve_python_function_range \
          "$after_file" \
          "$symbol"
      )"
      ;;
    #
     *.js|*.jsx|*.ts|*.tsx|*.html)
      after_resolved="$(
        trace_resolve_js_ts_function_range \
          "$after_file" \
          "$symbol"
      )"
      ;;

    *.sh|*.bash|*.zsh|*/trace|trace)
      after_resolved="$(
        trace_resolve_shell_function_range \
          "$after_file" \
          "$symbol"
      )"
      ;;

    *)
      print -r -- \
        "[trace] --diff-symbol does not support AFTER file type yet: $after_file" >&2
      return 1
      ;;
  esac
  case "$before_resolved" in
    NONE)
      print -r -- \
        "[trace] BEFORE symbol not found: $symbol" >&2
      return 1
      ;;
    MULTIPLE)
      print -r -- \
        "[trace] BEFORE symbol has multiple matches: $symbol" >&2
      return 1
      ;;
  esac

  case "$after_resolved" in
    NONE)
      print -r -- \
        "[trace] AFTER symbol not found: $symbol" >&2
      return 1
      ;;
    MULTIPLE)
      print -r -- \
        "[trace] AFTER symbol has multiple matches: $symbol" >&2
      return 1
      ;;
  esac

  local before_start="${before_resolved%% *}"
  local before_end="${before_resolved##* }"
  local after_start="${after_resolved%% *}"
  local after_end="${after_resolved##* }"

  local buffer_dir="${TRACE_BUFFER_DIR:-$HOME/.cache/trace}"
  local buffer_file="${TRACE_BUFFER_FILE:-$buffer_dir/buffer.txt}"
  local context_file="${TRACE_CONTEXT_FILE:-$buffer_dir/context.txt}"
  local counter_file="${TRACE_COUNTER_FILE:-$buffer_dir/counter.txt}"

  local temp_prefix="${buffer_file}.diff-symbol.$$"
  local before_slice="${temp_prefix}.before"
  local after_slice="${temp_prefix}.after"
  local diff_file="${temp_prefix}.diff"

  mkdir -p "$buffer_dir"

  : > "$buffer_file"
  : > "$before_slice"
  : > "$after_slice"
  : > "$diff_file"

  if [[ ! -f "$context_file" ]]; then
    : > "$context_file"
  fi

  if [[ ! -f "$counter_file" ]]; then
    print -r -- "0" > "$counter_file"
  fi

  sed -n \
    "${before_start},${before_end}p" \
    "$before_file" \
    > "$before_slice"

  sed -n \
    "${after_start},${after_end}p" \
    "$after_file" \
    > "$after_slice"

  local differences="present"

  if cmp -s -- "$before_slice" "$after_slice"; then
    differences="none"
  else
    if command -v git >/dev/null 2>&1; then
      git diff \
        --no-index \
        --no-color \
        -- \
        "$before_slice" \
        "$after_slice" \
        > "$diff_file" || true
    else
      diff -u \
        -- \
        "$before_slice" \
        "$after_slice" \
        > "$diff_file" || true
    fi
  fi

  {
    print -r -- "comparison-direction: BEFORE -> AFTER"
    print -r -- "comparison-kind: symbol"
    print -r -- "symbol: $symbol"
    print -r -- "before: $before_file"
    print -r -- "after: $after_file"
    print -r -- "before-lines: ${before_start}-${before_end}"
    print -r -- "after-lines: ${after_start}-${after_end}"
    print -r -- "differences: $differences"

    if [[ "$differences" == "present" ]]; then
      print -r -- ""
      cat "$diff_file"
    fi
  } > "$buffer_file"

  local run_no

  run_no="$(
    cat "$counter_file" 2>/dev/null ||
      print -r -- 0
  )"

  run_no=$((run_no + 1))
  print -r -- "$run_no" > "$counter_file"

  {
    print -r -- ""
    print -r -- \
      "==================== trace copy ${run_no} ===================="
    print -r -- "source: diff-symbol"
    print -r -- "symbol: $symbol"
    print -r -- "before: $before_file"
    print -r -- "after: $after_file"
    print -r -- \
      "============================================================="
    cat "$buffer_file"
  } >> "$context_file"

  cat "$buffer_file"

  local copy_target="none"

  if [[ -n "${TMUX:-}" ]] &&
     command -v tmux >/dev/null 2>&1; then
    tmux load-buffer "$context_file"
    copy_target="tmux buffer"

  elif command -v wl-copy >/dev/null 2>&1 &&
       [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    wl-copy < "$context_file"
    copy_target="Wayland clipboard"

  elif command -v xclip >/dev/null 2>&1 &&
       [[ -n "${DISPLAY:-}" ]]; then
    xclip \
      -selection clipboard \
      -in \
      < "$context_file"
    copy_target="X clipboard via xclip"

  elif command -v pbcopy >/dev/null 2>&1; then
    pbcopy < "$context_file"
    copy_target="macOS clipboard"
  fi

  local line_count

  line_count=$(
    wc -l < "$buffer_file" |
      tr -d ' '
  )

  trace_print_footer \
    "$copy_target" \
    "$context_file" \
    "$line_count" \
    "diff-symbol:${symbol}"

  rm -f -- \
    "$before_slice" \
    "$after_slice" \
    "$diff_file"
}


