           -path '*/obj' \) \
        -prune -o -print |
        sed "s#^\./##" |
        awk '
          NR == 1 { print; next }
          {
            path = $0
            depth = gsub("/", "/", path)
            name = path
            sub(/^.*\//, "", name)

            indent = ""
            for (i = 0; i < depth; i++) {
