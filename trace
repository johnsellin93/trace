      if (t ~ "^(public|private|protected|internal|static|virtual|override|sealed|async|partial|extern|new)[ \t]+.*[ \t]+" sym "[ \t]*\\(") return 1
      if (t ~ "^[A-Za-z0-9_<>,\\[\\]?]+[ \t]+" sym "[ \t]*\\(") return 1

      return 0
    }

    {
      lines[NR] = $0
    }

    END {
      start = 0

      for (i = 1; i <= NR; i++) {
        if (is_match(lines[i])) {
